@payload { 
  sender "adi" 
  target_agent "web" 
  intent "build" 
}

@i18n { 
  locale "id" { 
    title "SoleMates" 
    tagline "Temukan Sepatu Impian Anda" 
    sk1 "Harga Kompetitif" 
    sk2 "Kualitas Terbaik" 
    sk3 "Pengiriman Cepat" 
    topic_name "Sepatu" 
    topic_desc "Belanja Sepatu Online" 
  } 
  locale "en" { 
    title "SoleMates" 
    tagline "Find Your Dream Shoes" 
  } 
}

routes { 
  route "/" layout "home" transition "fade" 
}

ui_layout "home" { 
  navbar "SoleMates" 
  container { 
    flex column { 
      text "SoleMates" 
      text "Temukan Sepatu Impian Anda" 
      button "Belanja Sekarang" onClick cta 
    } 
  } 
  flex row { 
    card "Keunggulan Kami" { 
      text "Harga Kompetitif — harga yang bersaing" 
    } 
    card "Keunggulan Kami" { 
      text "Kualitas Terbaik — sepatu dengan kualitas tinggi" 
    } 
    card "Keunggulan Kami" { 
      text "Pengiriman Cepat — pengiriman yang cepat dan efisien" 
    } 
  } 
  card "Kontak" { 
    input "nama" placeholder "Nama Anda" bind: @state.nama validate "required" 
    input "email" placeholder "Email Anda" bind: @state.email validate "required|email" 
    button "Kirim Pesan" onClick kirim 
  } 
  footer " 2026 SoleMates — dibuat dengan bahasa ADILang + framework ADI" 
}

component App { 
  on_mount: @log_change("app_mounted") 
}

func cta() { 
  @log_change("cta") 
}

func kirim() { 
  @log_change("kirim") 
}
